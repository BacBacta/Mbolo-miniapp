# Nom de l'application affiché dans l'app, le bot et les notifications
APP_NAME=Odo

# Jeton du bot donné par @BotFather (obligatoire pour parler à Telegram)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse HTTPS publique de l'application (tunnel en local, hébergeur en production).
# Chez Render et chez Fly, laisse vide : le serveur déduit l'adresse des variables de l'hébergeur.
WEBAPP_URL=https://ton-adresse-publique.example

# Identifiant de la discussion Telegram qui reçoit les selfies à valider.
# Crée un groupe, ajoute-y ton bot, envoie /id dans le groupe.
# Obligatoire en production : sans lui, aucun selfie ne part en modération, personne ne peut
# être vérifié, et le serveur refuse de démarrer plutôt que de laisser tout le monde en attente.
ADMIN_CHAT_ID=

# Clé secrète pour afficher les QR codes des lieux partenaires : /qr/palmier.png?key=...
ADMIN_KEY=change-moi

# Ce que Telegram renvoie dans l'en-tête de chaque appel du webhook, et qui prouve que l'appel
# vient de lui. Absent, un secret est tiré au hasard à chaque démarrage, et le webhook est reposé
# avec : rien à faire pour développer. Pose-le en production pour que les appels soient reconnus
# dès le premier démarrage d'une machine neuve.
WEBHOOK_SECRET=

# Signe les sessions web. Sans lui, /moderation et /api/mod refusent en le disant : le reste de
# l'app tourne normalement. Génère une longue chaîne aléatoire, ne la mets jamais dans Git.
# Le même secret servira aux sessions de paiement de la version web.
WEB_SESSION_SECRET=

# Secret d'où se déduisent les codes des QR posés dans les lieux partenaires. Absent, un secret
# est tiré au hasard à chaque démarrage : pratique pour développer, mais les QR déjà imprimés
# cessent d'être reconnus. En production avec au moins un lieu, le serveur refuse de démarrer
# sans lui. Le changer renouvelle tous les codes d'un coup — c'est la rotation d'urgence, si
# une feuille circule en photo. Réimprime les QR après.
VENUE_SECRET=

# Chiffre les sauvegardes de la base (scripts/sauvegarde.js). Elles contiennent tous les messages
# et tous les profils : sans ce secret, le script refuse d'écrire plutôt que de les poser en clair.
# Garde-le AILLEURS que sur la machine — le perdre, c'est perdre toutes les copies d'un coup.
#   openssl rand -hex 32
BACKUP_SECRET=

# Durées de l'espace de modération, en secondes : la session, puis le lien qui l'ouvre.
# Le lien ne sert qu'une fois, quoi qu'il arrive.
MOD_SESSION_SEC=43200
MOD_LIEN_SEC=600

# Fuseau dans lequel l'espace de modération affiche les dates. Le serveur tourne en UTC : sans
# ça, l'équipe daterait mal un signalement d'une heure.
MOD_TIMEZONE=Africa/Douala

# Durée de conservation des événements de mesure, en jours. 0 : aucun événement n'est écrit —
# c'est ce qui rend la mesure refusable sans toucher au code. Une valeur illisible garde 180 et
# le dit au démarrage, pour qu'une faute de frappe n'éteigne pas la mesure en silence.
EVENTS_RETENTION_DAYS=180

PORT=3000

# Valide automatiquement les selfies et les photos après quelques secondes (tests uniquement).
# Sans effet quand NODE_ENV vaut production : valider sans qu'un humain regarde reviendrait à
# marquer « vérifié » quelqu'un que personne n'a vu, ce que l'app promet de ne jamais faire.
AUTO_APPROVE=true

# Ajoute des profils de démonstration qui te « likent » en retour (tests uniquement).
# À laisser à false dès qu'il y a de vraies personnes : elles écriraient à des profils fictifs.
SEED_DEMO=true

# Permet d'ouvrir l'app dans un navigateur classique, sans Telegram (développement uniquement)
ALLOW_DEV_AUTH=false

# false = le bot interroge Telegram (local) ; true = Telegram appelle ton serveur (production)
USE_WEBHOOK=false

# Politique de mise en relation pour « Relation sérieuse » : voir README, section Juridique.
#   romance_opposite (défaut) : femme et homme seulement. Personne ne choisit son genre
#     recherché, donc l'app ne collecte aucune donnée d'orientation. C'est ce qui protège les
#     membres au Cameroun, où l'article 347-1 du code pénal en fait une donnée dangereuse.
#   toute autre valeur (par exemple « open ») : la règle est levée, et c'est la personne qui dit
#     qui elle cherche, en relation sérieuse comme en amitié. Ce choix est alors une donnée
#     d'orientation : ne l'ouvre qu'après validation par un juriste local, et déclare-la.
#     Le réglage est global au serveur, pas par pays.
MATCH_POLICY=romance_opposite

# Ce que la vérification par selfie décide : voir README, section « Porte ou badge ».
#   gate (défaut) : elle est une porte. Tant qu'un humain n'a pas tranché, la personne ne voit
#     personne et personne ne la voit. C'est la promesse écrite dans les conditions.
#   badge : elle est un badge. On entre avec un profil, et le selfie vérifié donne un bouclier
#     sur la fiche. Restent réservés au bouclier : proposer un rendez-vous (des deux côtés),
#     confirmer une arrivée, et le quota entier de « J'aime ». Les pages publiques portent les
#     deux versions et n'en servent qu'une. À choisir quand la modération humaine ne peut pas
#     tenir le délai sans vider l'app.
VERIFICATION_POLICY=gate

# Le jour où les premiers vrais membres sont arrivés (AAAA-MM-JJ). La jauge de confiance ne
# montre « n sur 2 » sur les cartes qu'à partir de ce jour plus 90 jours : avant, « membre depuis
# 3 mois » n'est atteignable par personne, et chaque carte disait « 1 sur 2 ». Jusque-là, la
# carte ne montre que le selfie (« Vérifié »), et l'écran de la jauge garde la fraction.
LANCEMENT_LE=2026-09-13

# Profils que l'on peut aimer par jour tant qu'on n'a pas le bouclier (politique « badge »
# seulement). Le quota entier, lui, est de 5, et un pass Odo Plus l'enlève. Plus bas : un faux
# compte est ralenti avant qu'un humain l'ait vu, et se faire vérifier a un intérêt le jour même.
DAILY_PROFILES_UNVERIFIED=2

# Base PostgreSQL. Vide : les données vont dans un fichier JSON (DATA_DIR/db.json), ce qui suffit
# pour développer et pour une bêta sur une seule machine. Renseignée : PostgreSQL, avec les
# migrations appliquées au démarrage. Obligatoire avant tout paiement, et dès qu'il y a plus
# d'une instance. Reprendre un db.json existant : « node scripts/import-json.js ».
DATABASE_URL=

# Schéma PostgreSQL à utiliser. Vide : « public ». Sert à loger plusieurs installations dans une
# même base (un schéma par environnement). Lettres, chiffres et tiret bas uniquement.
DATABASE_SCHEMA=

# Dossier des données (base et photos). Par défaut : data/ dans le projet. Utile pour un volume persistant chez un hébergeur.
DATA_DIR=

# Délais des profils de démonstration (en millisecondes) : réponse à un message, like après la validation
DEMO_REPLY_DELAY_MS=15000
DEMO_LIKE_DELAY_MS=60000

# Limitation de débit par compte (messages, likes, signalements, vérification, photos,
# rendez-vous, modifications du profil). Compteurs en mémoire : ils repartent à zéro au
# redémarrage et ne sont pas partagés entre plusieurs instances. Ne mettre à false que pour
# un test de charge, jamais en production.
RATE_LIMIT=true

# La grille du pass Odo Plus, vendu dans l'application en Telegram Stars : « jours:stars »,
# séparés par des virgules. La durée du milieu est la conseillée. Une ligne illisible est ignorée ;
# vide, l'écran du pass dit qu'il n'est pas en vente sur ce serveur. Aucun prix n'est écrit dans
# le code ni dans l'interface : c'est ici qu'ils changent.
PLUS_PRIX_STARS=7:99,30:299,90:699

# Les pays où le pass n'est PAS vendu : codes ISO séparés par des virgules, ou le mot « afrique »
# (les 54 États et le Sahara occidental, server/geo.js). Là, ce que le pass ouvre est offert à
# tout le monde — sauf le quota de « J'aime » par jour, qui garde ses marches —, aucune facture
# ne part, et les conditions le disent. Le pays est celui déclaré sur le profil. Vide : vendu
# partout. Décision du propriétaire, 19 septembre 2026 : pas de monétisation en Afrique pour
# l'instant.
PLUS_SANS_VENTE_PAYS=

# Tests seulement : l'adresse de l'API Telegram que `scripts/chiffres.js --groupe` appelle,
# pour pointer un faux serveur local. Ne pas poser en production.
# TELEGRAM_API_ROOT=

# Fuseau horaire du serveur. Détermine l'heure à laquelle le quota journalier repart.
TZ=Africa/Douala

# Délai au-delà duquel un selfie que la modération n'a jamais tranché est supprimé et le compte
# remis en attente de vérification. La personne peut alors recommencer.
VERIFICATION_TTL_DAYS=7

# Pays proposé par défaut à l'inscription, code ISO 3166-1 alpha-2. L'app est ouverte à tous les
# pays : ce réglage ne fait que pré-remplir le menu, il n'en exclut aucun.
DEFAULT_COUNTRY=CM
