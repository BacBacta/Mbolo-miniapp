{
  "name": "odo-miniapp",
  "version": "0.1.0",
  "description": "Mini app Telegram de rencontres vérifiées pour l'Afrique (prototype déployable)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "test:pg": "node scripts/test-pg.js",
    "import:json": "node scripts/import-json.js",
    "mesure": "node scripts/mesure.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "chiffres": "node scripts/chiffres.js",
    "demo-photos": "node scripts/demo-photos.mjs",
    "identite": "node identite/source/rendre.mjs",
    "video": "node identite/video/rendre.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "jpeg-js": "^0.4.4",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  }
}
